  skipIntro: 0
  dialogue: {fileID: 1124480887}
  spawner: {fileID: 666592517}
  tutorial: {fileID: 1124480892}
  dedeSheet: {fileID: 2800000, guid: 66ec966d2971d66429955659155e9714, type: 3}
  dedeFace: {fileID: -7527145504033472756, guid: 1d777a5cd225b594a8233d2c724de1aa, type: 3}
  playerFace: {fileID: -7527145504033472756, guid: af576b27eebfbf14eb41387fb0bdf024, type: 3}
  dedeName: Dede
  playerName: Ben
  throwItems:
  - {fileID: 107360922}
  - {fileID: 1107018340}
  doorPos: {x: 0.5, y: 3.5}
  walkSpeed: 2
  meetDistance: 2.2
  startDelay: 1
  flightTime: 0.55
  arcHeight: 1
  lines:
  - dede: 1
    text: "Evlat, sonunda geldin. Bu kale dedemden bana kald\u0131, \u015Fimdi s\u0131ra
      sende."
    throwItemsAfter: 0
  - dede: 1
    text: "Karanl\u0131k yarat\u0131klar bu tarafa geliyor. Al bu yay\u0131 ve oklar\u0131,
      kalemizi koru!"
    throwItemsAfter: 1
  - dede: 0
    text: Dede, merak etme. Bu eve kimse zarar veremez!
    throwItemsAfter: 0
  - dede: 1
    text: "Ben i\xE7eride olaca\u011F\u0131m. Duvarlara g\xF6z kulak ol, hasar g\xF6ren
      yeri tamir etmeyi unutma."
    throwItemsAfter: 0
  - dede: 0
    text: "Haz\u0131r\u0131m dede. Gelsinler!"
    throwItemsAfter: 0
  bearSheet: {fileID: 2800000, guid: f67bfddd7abe5fd4aa45957d706a2cc5, type: 3}
  bearFace: {fileID: 21300000, guid: 391c2cae5f5303e47b461fb831101000, type: 3}
  bearName: "Ay\u0131"
  bearStartOffset: {x: 0, y: -9}
  bearStopOffset: {x: 0, y: -3.2}
  bearWalkSpeed: 2.5
  bearLines:
  - player: 0
    text: "Grr... Bu kale art\u0131k bizim olacak, ufakl\u0131k!"
  - player: 1
    text: "Bakal\u0131m! Dedemin kalesine kimse el s\xFCremez."
  - player: 0
    text: "S\xFCr\xFCm\xFCz geliyor. Seni ve o ihtiyar dedeyi ezece\u011Fiz!"
  - player: 1
    text: "Haz\u0131r\u0131m. Gelin bakal\u0131m!"
