  skipTutorial: 0
  skipKey: 116
  moveDistance: 4
  stepDoneSfx: {fileID: 8300000, guid: dfcca60c8e9546d43903ab757e7a4dc9, type: 3}
  steps:
  - type: 0
    text: W A S D ile hareket et.
    infoSeconds: 5
  - type: 1
    text: "Yerdeki yay\u0131 al: yan\u0131na git ve [E] tu\u015Funa bas."
    infoSeconds: 5
  - type: 2
    text: "Oku da al: yan\u0131na git ve [E] tu\u015Funa bas."
    infoSeconds: 5
  - type: 3
    text: "Yay\u0131 eline al: 1-4 tu\u015Flar\u0131 veya fare tekerle\u011Fi ile
      yay\u0131n oldu\u011Fu slotu se\xE7."
    infoSeconds: 5
  - type: 4
    text: "Sol t\u0131k\u0131 bas\u0131l\u0131 tut ve b\u0131rak: ok fareye do\u011Fru
      f\u0131rlar."
    infoSeconds: 5
  - type: 5
    text: "Evin sa\u011F\u0131ndaki tezg\xE2ha git ve [E] tu\u015Funa bas. Y\u0131k\u0131lan
      duvarlar\u0131 buradan tamir edersin."
    infoSeconds: 5
  - type: 6
    text: "Haz\u0131rs\u0131n! Yarat\u0131klar yakla\u015F\u0131yor, evi koru."
    infoSeconds: 3
